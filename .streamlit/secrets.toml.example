# Bu dosyayı kopyalayıp .streamlit/secrets.toml yapın (yerel) ya da içeriğini
# Streamlit Cloud > Manage app > Settings > Secrets bölümüne yapıştırın. secrets.toml'u ASLA GitHub'a yüklemeyin.

# --- Kalıcı veri (zorunlu değil ama bulutta ŞART): Neon / Supabase PostgreSQL bağlantı adresi
database_url = "postgresql://KULLANICI:SIFRE@HOST/VERITABANI?sslmode=require"

# --- Log zincirini imzalayan gizli anahtar (uzun, rastgele bir metin; kaybetmeyin!)
audit_key = "buraya-en-az-32-karakterlik-rastgele-bir-metin"

# --- Uygulamayı ortak parolayla koruma (isteğe bağlı ama bulutta önerilir)
app_password = "ortak-parola"

# --- İzin kağıdındaki QR kod için uygulamanın adresi (Yönetim > Ayarlar'dan da girilebilir)
app_url = "https://izin-takip.streamlit.app"

# --- Otomatik e-posta (isteğe bağlı). Gmail için "uygulama şifresi" kullanın.
smtp_host = "smtp.gmail.com"
smtp_port = 587
smtp_user = "ornek@gmail.com"
smtp_password = "uygulama-sifresi"
smtp_from = "ornek@gmail.com"
